{
    "name": "@markup-carve/reveal-carve",
    "version": "0.1.0",
    "description": "Write reveal.js presentations in Carve markup - a runtime plugin and a static build step.",
    "keywords": [
        "reveal.js",
        "reveal",
        "carve",
        "markup",
        "slides",
        "presentation"
    ],
    "homepage": "https://github.com/markup-carve/reveal-carve",
    "bugs": {
        "url": "https://github.com/markup-carve/reveal-carve/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markup-carve/reveal-carve.git"
    },
    "license": "MIT",
    "author": "Mark Scherer",
    "type": "module",
    "main": "./dist/reveal-carve.cjs",
    "exports": {
        ".": {
            "types": "./types/plugin.d.ts",
            "import": "./dist/reveal-carve.mjs",
            "require": "./dist/reveal-carve.cjs",
            "default": "./dist/reveal-carve.js"
        },
        "./plugin": {
            "types": "./types/plugin.d.ts",
            "default": "./src/plugin.js"
        },
        "./build": {
            "types": "./types/build.d.ts",
            "default": "./src/build.js"
        },
        "./lint": {
            "types": "./types/lint.d.ts",
            "default": "./src/lint.js"
        },
        "./handout": {
            "types": "./types/handout.d.ts",
            "default": "./src/handout.js"
        },
        "./dev": {
            "types": "./types/dev.d.ts",
            "default": "./src/dev.js"
        },
        "./pdf": {
            "types": "./types/pdf.d.ts",
            "default": "./src/pdf.js"
        },
        "./init": {
            "types": "./types/init.d.ts",
            "default": "./src/init.js"
        },
        "./theme.css": "./src/theme.css",
        "./package.json": "./package.json",
        "./theme-dark.css": "./src/theme-dark.css"
    },
    "bin": {
        "reveal-carve": "./src/cli.js"
    },
    "files": [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "dist",
        "src",
        "types"
    ],
    "scripts": {
        "build": "node scripts/build.mjs && npm run types",
        "test": "node --test test/*.test.js",
        "lint:demos": "node src/cli.js check demo/decks --include-root demo",
        "demo": "node src/cli.js watch demo/decks demo/generated.html --title \"reveal-carve demo\" --reveal-base ../node_modules/reveal.js/dist --port 8800",
        "prepublishOnly": "npm run lint && npm run build && npm test",
        "check:decks": "node scripts/check-decks.mjs site",
        "coverage": "node --test --experimental-test-coverage test/*.test.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check:contrast": "node scripts/check-contrast.mjs",
        "check:pdf": "node scripts/check-pdf.mjs site",
        "types": "tsc -p tsconfig.json",
        "docs": "node scripts/build-docs.mjs"
    },
    "peerDependencies": {
        "@markup-carve/carve": ">=0.1.7 <0.2.0",
        "reveal.js": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "reveal.js": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@markup-carve/carve": "^0.1.7",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "linkedom": "^0.18.13",
        "reveal.js": "^6.0.2",
        "typescript": "^7.0.2"
    },
    "module": "./dist/reveal-carve.mjs",
    "dependencies": {
        "yaml": "^2.9.1"
    },
    "types": "./types/plugin.d.ts"
}
