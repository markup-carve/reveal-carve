{
    "name": "@markup-carve/reveal-carve",
    "version": "0.1.0",
    "description": "Write reveal.js presentations in Carve markup - a runtime plugin and a static build step.",
    "keywords": [
        "reveal.js",
        "reveal",
        "carve",
        "markup",
        "slides",
        "presentation"
    ],
    "homepage": "https://github.com/markup-carve/reveal-carve",
    "bugs": {
        "url": "https://github.com/markup-carve/reveal-carve/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markup-carve/reveal-carve.git"
    },
    "license": "MIT",
    "author": "Mark Scherer",
    "type": "module",
    "main": "./dist/reveal-carve.cjs",
    "exports": {
        ".": {
            "import": "./dist/reveal-carve.mjs",
            "require": "./dist/reveal-carve.cjs",
            "default": "./dist/reveal-carve.js"
        },
        "./plugin": "./src/plugin.js",
        "./build": "./src/build.js",
        "./lint": "./src/lint.js",
        "./handout": "./src/handout.js",
        "./dev": "./src/dev.js",
        "./theme.css": "./src/theme.css",
        "./package.json": "./package.json"
    },
    "bin": {
        "reveal-carve": "./src/cli.js"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "node --test test/*.test.js",
        "lint:demos": "node src/cli.js lint demo/decks",
        "demo": "node src/cli.js watch demo/decks demo/generated.html --title \"reveal-carve demo\" --reveal-base ../node_modules/reveal.js/dist --port 8800",
        "prepublishOnly": "npm run build && npm test"
    },
    "peerDependencies": {
        "@markup-carve/carve": ">=0.1.3",
        "reveal.js": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "reveal.js": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@markup-carve/carve": "^0.1.7",
        "esbuild": "^0.28.2",
        "reveal.js": "^6.0.2"
    },
    "module": "./dist/reveal-carve.mjs"
}
