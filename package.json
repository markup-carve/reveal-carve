{
    "name": "@markup-carve/reveal-carve",
    "version": "0.1.0",
    "description": "Write reveal.js presentations in Carve markup - a runtime plugin and a static build step.",
    "keywords": [
        "reveal.js",
        "reveal",
        "carve",
        "markup",
        "slides",
        "presentation"
    ],
    "homepage": "https://github.com/markup-carve/reveal-carve",
    "bugs": {
        "url": "https://github.com/markup-carve/reveal-carve/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markup-carve/reveal-carve.git"
    },
    "license": "MIT",
    "author": "Mark Scherer",
    "type": "module",
    "main": "./src/plugin.js",
    "exports": {
        ".": "./src/plugin.js",
        "./build": "./src/build.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "reveal-carve": "./src/cli.js"
    },
    "files": [
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test 'test/*.test.js'",
        "demo:static": "node src/cli.js demo/deck.crv demo/static.html --title \"reveal-carve\" --reveal-base ../node_modules/reveal.js/dist"
    },
    "peerDependencies": {
        "@markup-carve/carve": ">=0.1.3",
        "reveal.js": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "reveal.js": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@markup-carve/carve": "^0.1.7",
        "reveal.js": "^6.0.2"
    }
}
